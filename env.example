# ==========================================
# GRAS Transit Scraper Configuration
# ==========================================

LOG_LEVEL=INFO
SCRAPE_INTERVAL_SECONDS=30

# --- OPTION A: Standalone Setup (Batteries Included) ---
# Uncomment the line below to spin up the local PostgreSQL 18 container automatically.
COMPOSE_PROFILES=local-db

POSTGRES_USER=gras
POSTGRES_PASSWORD=password
POSTGRES_DB=gras
POSTGRES_PORT=5432

# --- OPTION B: Shared Infrastructure (Bring Your Own Database) ---
# If you are pointing to an existing external database, leave COMPOSE_PROFILES
# commented out and supply your custom URI:
# DATABASE_URL=postgresql+psycopg://user:pass@host.docker.internal:5432/gras
